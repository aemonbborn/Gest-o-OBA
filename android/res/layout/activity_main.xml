<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="#f3f6f5">
    <LinearLayout android:id="@+id/content" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp" android:focusableInTouchMode="true">
        <ImageView android:layout_width="72dp" android:layout_height="72dp" android:layout_gravity="center_horizontal" android:layout_marginTop="24dp" android:src="@drawable/app_icon" android:contentDescription="@string/app_name" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/app_name" android:textSize="25sp" android:textStyle="bold" android:textColor="#16675e" android:gravity="center" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/intro" android:textSize="16sp" android:textColor="#647873" android:gravity="center" />
        <LinearLayout android:id="@+id/connection_form" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/connection_help" android:textColor="#203a37" android:textSize="14sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/connection_label" android:textSize="14sp" android:textStyle="bold" android:labelFor="@+id/program_url" />
            <EditText android:id="@+id/program_url" android:layout_width="match_parent" android:layout_height="56dp" android:hint="@string/connection_hint" android:inputType="textUri" android:singleLine="true" android:importantForAutofill="no" android:selectAllOnFocus="true" android:textSize="14sp" />
            <Button android:id="@+id/paste" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/paste" android:textAllCaps="false" />
        </LinearLayout>
        <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:textSize="14sp" android:textColor="#647873" android:visibility="gone" android:accessibilityLiveRegion="polite" />
        <Button android:id="@+id/open" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="16dp" android:text="@string/save_open" android:textAllCaps="false" android:backgroundTint="#16675e" android:textColor="#ffffff" />
        <Button android:id="@+id/edit_connection" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/edit_connection" android:textAllCaps="false" android:visibility="gone" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/google_account_hint" android:textSize="13sp" android:textColor="#647873" />
        <Button android:id="@+id/help" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:layout_marginTop="12dp" android:text="@string/help" android:textAllCaps="false" />
    </LinearLayout>
</ScrollView>
